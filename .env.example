# Contact form delivery (server-side only — never exposed to the browser).
# Copy this file to .env.local and fill in real values.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact-form enquiries are delivered.
CONTACT_TO_EMAIL=you@example.com

# Optional: a Resend-verified sender. Defaults to onboarding@resend.dev for testing.
# CONTACT_FROM_EMAIL=Your Name <hello@yourdomain.com>
